
APP_NAME="Study Planner"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_URL=http://127.0.0.1:8080

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_request_container_db
DB_USERNAME=laravel_app
DB_PASSWORD=REPLACE_WITH_LOCAL_SECRET
DB_ROOT_PASSWORD=REPLACE_WITH_LOCAL_ROOT_SECRET
